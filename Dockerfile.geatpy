FROM python:3.10-slim@sha256:31dd4d9529d02d7436659061cb7564cd4733fc90e5e152709a942d53382ec8d0

ENV DEBIAN_FRONTEND=noninteractive \
    MPLBACKEND=Agg \
    PYTHONDONTWRITEBYTECODE=1 \
    REQUIRE_GEATPY=1

# The official Geatpy wheel links against GNU OpenMP (libgomp.so.1).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-geatpy.txt /tmp/requirements-geatpy.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-geatpy.txt

WORKDIR /work
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-p", "integration_geatpy.py", "-v"]
